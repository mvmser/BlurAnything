# Security headers + caching for Netlify and Cloudflare Pages (publish directory: web).
# Hosts without custom-header support ignore this file; the same CSP is also set through a <meta> tag in index.html.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Model URLs carry a content hash (?v=...), so they can be cached for a year.
/models/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=86400
/samples/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400

# Code is always revalidated (cheap 304s) so a deploy is live immediately.
/index.html
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
